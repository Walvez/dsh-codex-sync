{
  "name": "dsh-codex-sync",
  "version": "0.1.0",
  "description": "One-stop bidirectional sync between OpenAI Codex and DeepSeek Harness (dsh): first-class skills, session import, workspace attach, MCP client mounting, and a Codex-side reverse MCP installer.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "codex",
    "deepseek-harness",
    "mcp",
    "skills",
    "sync"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "bin",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "bin": {
    "dsh-codex-sync": "./bin/dsh-codex-sync.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-mcp-client": "^0.0.1-rc.1",
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-mcp-client": {
      "optional": true
    }
  }
}
